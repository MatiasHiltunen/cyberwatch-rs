BIND_ADDRESS=127.0.0.1:8080
DATABASE_PATH=./data/cyberwatch.db
WEB_DIR=./web
RUST_LOG=cyberwatch_rs=info,tower_http=info

# Disconnected teaching/CI: seed 4 fictional records and disable ALL refresh.
# Use a dedicated database (e.g. ./data/demo.db); demo/live databases cannot mix.
DEMO_MODE=false
REFRESH_ENABLED=true

# Refresh scheduling
REFRESH_INTERVAL_SECONDS=900
REFRESH_ON_START=true
REFRESH_QUEUE_CAPACITY=1
SOURCE_CONCURRENCY=8
VALIDATION_CONCURRENCY=8
VALIDATION_BATCH_SIZE=250

# Network safety and retry controls
# Outbound ingestion permits public HTTP(S) only; redirects and DNS are checked.
# Ambient HTTP(S)_PROXY values are ignored. Enforce egress at the network boundary.
# API: fixed 64 handler admissions, 10s deadline (2s probes), 4096-byte URI limit.
HTTP_CONNECT_TIMEOUT_SECONDS=15
SOURCE_TIMEOUT_SECONDS=120
SOURCE_RETRY_ATTEMPTS=2
MAX_SOURCE_RESPONSE_BYTES=33554432
SOURCE_FAILURE_BACKOFF_SECONDS=60
SOURCE_FAILURE_BACKOFF_MAX_SECONDS=3600

# NVD
NVD_API_KEY=
NVD_RESULTS_PER_PAGE=500
NVD_INITIAL_WINDOW_DAYS=7
NVD_OVERLAP_MINUTES=10

# Optional GitHub token for higher advisory API limits
GITHUB_TOKEN=
GITHUB_ADVISORY_PAGES=3

# API security. Set this before exposing the service outside localhost.
# A random token of at least 32 bytes is mandatory on a non-loopback bind.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=
# Prefer mounted secret files in containers. Set TOKEN or TOKEN_FILE, never both.
ADMIN_TOKEN_FILE=
NVD_API_KEY_FILE=
GITHUB_TOKEN_FILE=

# Source customization
SOURCE_CONFIG_PATH=
NEWS_FEEDS_JSON=
DISABLED_SOURCES=

# Retention
NEWS_RETENTION_DAYS=730
INGESTION_RUN_RETENTION_DAYS=90
